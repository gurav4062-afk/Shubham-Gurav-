#include <stdio.h>
#include <string.h>

// Function to get decimal value of a Roman numeral character
int value(char r) {
    switch(r) {
        case 'I': return 1;
        case 'V': return 5;
        case 'X': return 10;
        case 'L': return 50;
        case 'C': return 100;
        case 'D': return 500;
        case 'M': return 1000;
        default: return 0;
    }
}

// Function to convert Roman numeral to decimal
int romanToDecimal(char roman[]) {
    int total = 0;
    int prev = 0;
    int len = strlen(roman);

    for(int i = len-1; i >= 0; i--) {
        int curr = value(roman[i]);
        if(curr < prev)
            total -= curr;
        else
            total += curr;
        prev = curr;
    }
    return total;
}

int main() {
    int N;
    printf("Enter N: ");
    scanf("%d", &N);

    char *romanNumerals[] = {
        "I","II","III","IV","V","VI","VII","VIII","IX","X",
        "XI","XII","XIII","XIV","XV","XVI","XVII","XVIII","XIX","XX"
    };

    printf("\nNumbers from 1 to %d with Roman to Decimal conversion:\n", N);

    for(int i = 1; i <= N; i++) {
        if(i <= 20) {
            printf("%s -> %d\n", romanNumerals[i-1], romanToDecimal(romanNumerals[i-1]));
        } else {
            printf("%d\n", i);
        }
    }

    return 0;
}
